            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"{{productRef}}\",\n  \"name\": \"Laptop Pro 15\",\n  \"description\": \"Ordinateur portable 15 pouces, 16 Go RAM\",\n  \"price\": 12999.9,\n  \"category\": \"Informatique\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Même référence que la requête 1 : doit être refusée."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 Conflict\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"Format d'erreur standard (timestamp, status, error, message, path)\", function () { const b = pm.response.json(); pm.expect(b).to.have.all.keys(\"timestamp\", \"status\", \"error\", \"message\", \"path\", \"validationErrors\"); pm.expect(b.status).to.eql(pm.response.code); });"
                ]
              }
            }
          ]
        },
