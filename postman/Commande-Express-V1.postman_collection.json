                  "pm.test(\"Détail des champs invalides\", function () { const v = pm.response.json().validationErrors; pm.expect(v).to.have.property(\"reference\"); pm.expect(v).to.have.property(\"name\"); pm.expect(v).to.have.property(\"price\"); });"
                ]
              }
            }
          ]
        },
